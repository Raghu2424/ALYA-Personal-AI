rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Authenticated User Partition
    match /users/{userId} {
      // User profile document: only the authenticated user can access their own document
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null && request.auth.uid == userId
        && (!('uid' in request.resource.data) || request.resource.data.uid == userId);
      allow delete: if request.auth != null && request.auth.uid == userId;

      // Personal memories: strictly owner-bound with ownerUid validation
      match /memories/{memoryId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create, update: if request.auth != null && request.auth.uid == userId
          && (!('ownerUid' in request.resource.data) || request.resource.data.ownerUid == userId);
        allow delete: if request.auth != null && request.auth.uid == userId;
      }

      // Goals: strictly owner-bound with ownerUid validation
      match /goals/{goalId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create, update: if request.auth != null && request.auth.uid == userId
          && (!('ownerUid' in request.resource.data) || request.resource.data.ownerUid == userId);
        allow delete: if request.auth != null && request.auth.uid == userId;
      }

      // Tasks: strictly owner-bound with ownerUid validation
      match /tasks/{taskId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create, update: if request.auth != null && request.auth.uid == userId
          && (!('ownerUid' in request.resource.data) || request.resource.data.ownerUid == userId);
        allow delete: if request.auth != null && request.auth.uid == userId;
      }

      // Journal entries: strictly private reflections with ownerUid validation
      match /journal/{entryId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create, update: if request.auth != null && request.auth.uid == userId
          && (!('ownerUid' in request.resource.data) || request.resource.data.ownerUid == userId);
        allow delete: if request.auth != null && request.auth.uid == userId;
      }

      // Conversations & chat history: private to authenticated owner
      match /conversations/{conversationId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create, update: if request.auth != null && request.auth.uid == userId;
        allow delete: if request.auth != null && request.auth.uid == userId;
      }

      // Interactions / activity logs: private to authenticated owner
      match /interactions/{interactionId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create, update: if request.auth != null && request.auth.uid == userId;
        allow delete: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}


